btnLancar.MouseButton1Click:Connect(function()
    lancarAtivo = not lancarAtivo
    btnLancar.Text = lancarAtivo and "LANÇAR ON" or "LANÇAR OFF"
    
    if lancarAtivo then
        -- Dispara o Remote de Spawn do veículo
        local args = {"PickingCar", "Bobsled", "Event"}
        pcall(function() ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Ca1r"):FireServer(unpack(args)) end)
    else
        -- Limpa ataques
        objetosSelecionados = {}
        if conexaoAtaque then conexaoAtaque:Disconnect() end
    end
end)

-- Atualização da lista de jogadores
local function atualizarLista()
    playerList:ClearAllChildren()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local btn = Instance.new("TextButton")
            btn.Text = p.Name
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.Parent = playerList
            btn.MouseButton1Click:Connect(function()
                jogadorAlvoSelecionado = p
            end)
        end
    end
end

-- Toggle da UI
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        mainFrame.Visible = not mainFrame.Visible
        atualizarLista()
    end
end)