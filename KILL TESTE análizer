-- Atualizar lista de jogadores
local function atualizarLista()
    list:ClearAllChildren()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= lp then
            local btn = Instance.new("TextButton", list)
            btn.Size = UDim2.new(1, -10, 0, 30); btn.Text = player.Name; btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            btn.MouseButton1Click:Connect(function()
                alvoSelecionado = player
                for _, child in pairs(list:GetChildren()) do child.BackgroundColor3 = Color3.fromRGB(50,50,50) end
                btn.BackgroundColor3 = Color3.fromRGB(100, 0, 0) -- Destaque
            end)
        end
    end
end
