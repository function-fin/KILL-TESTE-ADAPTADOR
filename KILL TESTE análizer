local function atualizarListaJogadores()
    for _, child in pairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local filtro = searchBox.Text:lower()
    local alturaTotal = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp then
            local nome = plr.Name
            local displayName = plr.DisplayName

            if filtro == "" or nome:lower():find(filtro) or displayName:lower():find(filtro) then
                local pBtn = Instance.new("TextButton")
                pBtn.Name = nome
                pBtn.Size = UDim2.new(1, 0, 0, 22)
                pBtn.BackgroundTransparency = 1
                pBtn.BorderSizePixel = 0
                pBtn.Text = displayName
                pBtn.TextColor3 = (jogadorAlvoSelecionado == plr) and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(255, 255, 255)
                pBtn.Font = Enum.Font.Arcade
                pBtn.TextSize = 18
                pBtn.TextXAlignment = Enum.TextXAlignment.Left
                pBtn.Parent = playerScroll

                pBtn.MouseButton1Click:Connect(function()
                    jogadorAlvoSelecionado = plr
                    atualizarListaJogadores()

                    if lancarAtivo then
                        executarLancamentoAuto()
                    elseif #objetosSelecionados > 0 then
                        iniciarAtaqueMassa(plr)
                    end
                end)

                alturaTotal = alturaTotal + 26
            end
        end
    end

    playerScroll.CanvasSize = UDim2.new(0, 0, 0, alturaTotal)
end

local function criarBotoesMetodos()
    for _, child in pairs(methodScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local alturaTotal = 0
    for _, item in ipairs(listaMetodos) do
        local mBtn = Instance.new("TextButton")
        mBtn.Name = item.Id
        mBtn.Size = UDim2.new(1, 0, 0, 26)
        mBtn.BackgroundTransparency = 1
        mBtn.BorderSizePixel = 0
        mBtn.Text = item.NomeExibicao
        mBtn.TextColor3 = (metodoSelecionado == item.Id) and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(255, 255, 255)
        mBtn.Font = Enum.Font.Arcade
        mBtn.TextSize = 22
        mBtn.TextXAlignment = Enum.TextXAlignment.Left
        mBtn.Parent = methodScroll

        mBtn.MouseButton1Click:Connect(function()
            metodoSelecionado = item.Id
            criarBotoesMetodos()

            if lancarAtivo and jogadorAlvoSelecionado then
                executarLancamentoAuto()
            end
     end)

        alturaTotal = alturaTotal + 32
    end
    methodScroll.CanvasSize = UDim2.new(0, 0, 0, alturaTotal)
end

