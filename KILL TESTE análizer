            btn.Size = UDim2.new(1, 0, 0, 25); btn.Text = p.Name; btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.new(1,1,1); btn.MouseButton1Click:Connect(function() alvoSelecionado = p; 
                for _, c in pairs(scrollList:GetChildren()) do c.BackgroundColor3 = Color3.fromRGB(50,50,50) end
                btn.BackgroundColor3 = Color3.fromRGB(150,0,0)
            end)
        end
    end
end
