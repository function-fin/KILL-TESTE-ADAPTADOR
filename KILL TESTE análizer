-- ============================================
-- LÓGICA DE DETECÇÃO AUTOMÁTICA
-- ============================================
task.spawn(function()
    while true do
        task.wait(1)
        local vehicles = Workspace:FindFirstChild("Vehicles")
        local found = nil
        
        if vehicles then
            for _, v in pairs(vehicles:GetChildren()) do
                if v.Name:find("Bobsled") or v.Name:find("Car") then
                    found = v
                    break
                end
            end
        end
        
        statusVeiculoAzul = (found and 1 or 0)
        statusLabel.Text = "Veículo azul: " .. statusVeiculoAzul
        
        -- Automação do Method I
        if lancarAtivo and statusVeiculoAzul == 1 and jogadorAlvoSelecionado then
            if #objetosSelecionados == 0 then
                -- Seleciona o veículo encontrado automaticamente
                local seat = found:FindFirstChild("Seats", true) or found:FindFirstChildOfClass("VehicleSeat", true)
                if seat then
                    -- Executa bypass e popula objetosSelecionados
                    for _, desc in pairs(found:GetDescendants()) do
                        if desc:IsA("BasePart") and not desc.Anchored then
                            table.insert(objetosSelecionados, desc)
                        end
                    end
                    -- Inicia ataque
                    if conexaoAtaque then conexaoAtaque:Disconnect() end
                    -- Reutiliza sua função de fling
                    iniciarAtaqueMassa(jogadorAlvoSelecionado)
                end
            end
        end
    end
end)

