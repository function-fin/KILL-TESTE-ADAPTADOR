-- Atualização Simples de Jogadores
local function atualizarLista()
    playerScroll:ClearAllChildren()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local btn = Instance.new("TextButton", playerScroll)
            btn.Text = p.Name
            btn.Size = UDim2.new(1, 0, 0, 22)
            btn.BackgroundTransparency = 1
            btn.TextColor3 = (p == jogadorAlvoSelecionado) and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(255, 255, 255)
            btn.MouseButton1Click:Connect(function() 
                jogadorAlvoSelecionado = p 
                atualizarLista()
            end)
        end
    end
end

actionButton.MouseButton1Click:Connect(function() mainFrame.Visible = not mainFrame.Visible; atualizarLista() end)
Players.PlayerAdded:Connect(atualizarLista)
