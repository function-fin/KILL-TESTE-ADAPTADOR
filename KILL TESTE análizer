-- ============================================
-- ATUALIZAR LISTA DE JOGADORES
-- ============================================
local function atualizarListaJogadores(filtro)
    if not interfaceUI then return end

    for _, child in pairs(interfaceUI.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    local filtroLower = filtro and string.lower(filtro) or ""

    for _, player in pairs(players) do
        if player ~= lp then
            local nome = player.Name
            if filtroLower == "" or string.find(string.lower(nome), filtroLower) then
                local playerBtn = Instance.new("TextButton")
                playerBtn.Size = UDim2.new(1, 0, 0, 28)
                playerBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
                playerBtn.Text = "  " .. nome
                playerBtn.TextColor3 = Color3.fromRGB(220, 220, 255)
                playerBtn.TextXAlignment = Enum.TextXAlignment.Left
                playerBtn.Font = Enum.Font.Gotham
                playerBtn.TextSize = 13
                playerBtn.BackgroundTransparency = 0.2
                playerBtn.AutoButtonColor = false
                playerBtn.Parent = interfaceUI.PlayerList

                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 4)
                btnCorner.Parent = playerBtn

                playerBtn.MouseEnter:Connect(function()
                    if jogadorSelecionado ~= player then
                        playerBtn.BackgroundTransparency = 0.05
                    end
                end)
                playerBtn.MouseLeave:Connect(function()
                    if jogadorSelecionado ~= player then
                        playerBtn.BackgroundTransparency = 0.2
                    end
                end)

                playerBtn.MouseButton1Click:Connect(function()
                    for _, child in pairs(interfaceUI.PlayerList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child.BackgroundTransparency = 0.2
                            child.Size = UDim2.new(1, 0, 0, 28)
                            child.TextColor3 = Color3.fromRGB(220, 220, 255)
                            child.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
                        end
                    end

                    jogadorSelecionado = player
                    playerBtn.BackgroundTransparency = 0
                    playerBtn.Size = UDim2.new(1, 0, 0, 36)
                    playerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    playerBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
                end)
            end
        end
    end

    local count = 0
    for _, child in pairs(interfaceUI.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            count = count + 1
        end
    end
    interfaceUI.PlayerList.CanvasSize = UDim2.new(0, 0, 0, math.max(count * 31 + 10, 140))
end

-- ============================================
-- ENCONTRAR VEÍCULOS DO JOGADOR
-- ============================================
local function encontrarVeiculosDoJogador()
    local veiculos = {}
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    
    if vehiclesFolder then
        for _, modelo in pairs(vehiclesFolder:GetChildren()) do
            if modelo:IsA("Model") then
                if string.find(modelo.Name, lp.Name) or string.find(modelo.Name, "Gabrielle") then
                    local primaryPart = modelo.PrimaryPart or modelo:FindFirstChildOfClass("VehicleSeat")
                    if primaryPart then
                        table.insert(veiculos, primaryPart)
                        
                        -- Verifica se é helicóptero
                        local nomeLower = string.lower(modelo.Name)
                        if nomeLower:find("helicopter") or nomeLower:find("chinook") or nomeLower:find("chopper") then
                            local seat = modelo:FindFirstChildOfClass("VehicleSeat") or modelo:FindFirstChild("PilotSeat", true)
                            if seat then
                                executarBypassNetworkOwnership(seat)
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Buscar por NetworkOwner
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local owner = obj:GetNetworkOwner()
            if owner == lp then
                local modeloPai = obj:FindFirstAncestorOfClass("Model")
                if modeloPai and modeloPai:FindFirstChildOfClass("VehicleSeat") then
                    local duplicado = false
                    for _, v in pairs(veiculos) do
                        if v == obj then duplicado = true; break end
                    end
                    if not duplicado then
                        table.insert(veiculos, obj)
                    end
                end
            end
        end
    end
    
    return veiculos
end

-- ============================================
-- FUNÇÃO PRINCIPAL: LANÇAR MATTER
-- ============================================
local function lancarMatter()
    if not jogadorSelecionado then
        print("⚠️ Selecione um jogador primeiro!")
        return
    end

    print("🔍 Coletando veículos...")
    
    local veiculos = encontrarVeiculosDoJogador()
    
    if #veiculos == 0 then
        print("⚠️ Nenhum veículo encontrado!")
        return
    end
    
    print("🚗 Veículos encontrados:", #veiculos)
    
    -- Atribuir veículos à variável global
    objetosSelecionados = veiculos
    atualizarTexto()
    
    -- Executar ataque
    iniciarAtaqueMassa(jogadorSelecionado)
    
    -- Resetar seleção visual
    for _, child in pairs(interfaceUI.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child.BackgroundTransparency = 0.2
            child.Size = UDim2.new(1, 0, 0, 28)
            child.TextColor3 = Color3.fromRGB(220, 220, 255)
            child.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
        end
    end
    jogadorSelecionado = nil
end

