-- --- VERIFICAÇÃO ESPECÍFICA DE HELICÓPTEROS ---
local function ehHelicoptero(instancia)
    if not instancia then return false end
    
    -- Verifica se está dentro da pasta Helicopters
    if instancia:FindFirstAncestor("Helicopters") then
        return true
    end
    
    -- Verifica se é um modelo específico
    local model = instancia:IsA("Model") and instancia or instancia:FindFirstAncestorOfClass("Model")
    if not model then return false end
    
    local nome = string.lower(model.Name)
    
    -- Lista de nomes de helicópteros do Project Backpack
    if string.find(nome, "chinook") or 
       string.find(nome, "uh-60") or 
       string.find(nome, "heli") or 
       string.find(nome, "copter") or
       string.find(nome, "apache") or
       string.find(nome, "blackhawk") then
        return true
    end
    
    -- Verifica se tem partes típicas de helicóptero
    if model:FindFirstChild("MainRotor") or 
       model:FindFirstChild("TailRotor") or
       model:FindFirstChild("Rotor") or
       model:FindFirstChild("Blades") then
        return true
    end
    
    return false
end

