-- --- FUNÇÕES BASE ---
local function atualizarTexto()
    actionButton.Text = (#objetosSelecionados > 0) and ("DESTROY\n(" .. #objetosSelecionados .. ")") or "SELECT\nMATTER V4"
end

local function resetarEstado()
    if conexaoAtaque then conexaoAtaque:Disconnect(); conexaoAtaque = nil end
    objetosSelecionados = {}
    modoAtivo = false
    gui.Enabled = false
    actionButton.BackgroundTransparency = 0
    atualizarTexto()
end

local function aplicarMotoresFling(corpo)
    for _, child in pairs(corpo:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then child:Destroy() end
    end
    corpo.CanCollide = true
    corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)
    local v = Instance.new("BodyVelocity", corpo); v.Velocity = Vector3.new(999999,999999,999999); v.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    local av = Instance.new("BodyAngularVelocity", corpo); av.AngularVelocity = Vector3.new(999999,999999,999999); av.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
end

-- Bypass restrito apenas a helicópteros
local function executarBypassNetworkOwnership(assentoAlvo)
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    local meuHum = character and character:FindFirstChildOfClass("Humanoid")
    if not meuHRP or not assentoAlvo then return end
    local posOrig = meuHRP.CFrame
    meuHRP.CFrame = assentoAlvo.CFrame
    task.wait(0.3)
    meuHum.Sit = false; meuHum.Jump = true
    task.wait(0.2)
    meuHRP.CFrame = posOrig
end

-- --- VARREDURA SELETIVA ---
local function escanearEColetar()
    objetosSelecionados = {}
    local meuNick = lp.Name

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(obj.Name, meuNick) then
            local alvoFisico = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if alvoFisico and alvoFisico.Anchored == false then
                table.insert(objetosSelecionados, alvoFisico)
                
                -- IDENTIFICAÇÃO DE HELICÓPTERO
                local nomeObj = string.lower(obj.Name)
                local eHelicoptero = string.find(nomeObj, "helicopter") or string.find(nomeObj, "chinook") or obj:FindFirstAncestor("Helicopters")
                
                if eHelicoptero then
                    local assento = obj:FindFirstChild("PilotSeat", true) or obj:FindFirstChildOfClass("VehicleSeat")
                    if assento then executarBypassNetworkOwnership(assento) end
                end
            end
        end
    end
    atualizarTexto()
end

-- --- EXECUÇÃO DE ATAQUE ---
local function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or not alvoChar:FindFirstChild("HumanoidRootPart") then return end
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    
    for _, objeto in pairs(objetosSelecionados) do
        if objeto and objeto.Parent then
            aplicarMotoresFling(objeto)
            local nc = Instance.new("NoCollisionConstraint", objeto); nc.Part0 = objeto; nc.Part1 = meuHRP
            if sethp then pcall(function() sethp(objeto, "NetworkOwner", lp) end) end
        end
    end

    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent or #objetosSelecionados == 0 then resetarEstado(); return end
        local p = alvoChar:FindFirstChild("HumanoidRootPart")
        if p then
            local tempo = tick() * 45
            for i, objeto in pairs(objetosSelecionados) do
                local ang = tempo + (i * (math.pi / #objetosSelecionados))
                objeto.CFrame = CFrame.new(p.Position + Vector3.new(math.cos(ang)*3, 2, math.sin(ang)*3))
            end
        end
    end)
end

