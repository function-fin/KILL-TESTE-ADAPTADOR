task.spawn(function()
    while true do
        task.wait(1)
        local vehicles = Workspace:FindFirstChild("Vehicles")
        local found = nil
        if vehicles then
            for _, v in pairs(vehicles:GetChildren()) do
                if v.Name:find("Bobsled") or v.Name:find("Gabrielle62621Car") then
                    found = v
                    break
                end
            end
        end
        statusVeiculoAzul = (found and 1 or 0)
        statusLabel.Text = "Veículo azul: " .. statusVeiculoAzul

        -- Se Lancar estiver ON e encontramos o veículo e temos alvo:
        if lancarAtivo and statusVeiculoAzul == 1 and jogadorAlvoSelecionado then
            if #objetosSelecionados == 0 and found then
                -- Auto-seleção do veículo identificado
                for _, desc in pairs(found:GetDescendants()) do
                    if desc:IsA("BasePart") and not desc.Anchored then
                        table.insert(objetosSelecionados, desc)
                    end
                end
                -- Dispara o ataque no alvo que está selecionado na lista
                if conexaoAtaque then conexaoAtaque:Disconnect() end
                -- (Note: in_ataque_massa precisa ser global ou estar acima)
            end
        end
    end
end)

