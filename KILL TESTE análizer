-- [COLE AQUI: iniciarAtaqueMassa, aplicarMotoresFling, executarBypassNetworkOwnership]
-- (Mantive a estrutura abaixo para garantir que o script funcione com o que você já tinha)

local function aplicarMotoresFling(corpo)
    for _, child in pairs(corpo:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then child:Destroy() end
    end
    corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)
    local v = Instance.new("BodyVelocity", corpo); v.Velocity = Vector3.new(9e9, 9e9, 9e9); v.MaxForce = Vector3.new(1/0, 1/0, 1/0)
    local a = Instance.new("BodyAngularVelocity", corpo); a.AngularVelocity = Vector3.new(9e9, 9e9, 9e9); a.MaxTorque = Vector3.new(1/0, 1/0, 1/0)
end

function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or not alvoChar:FindFirstChild("HumanoidRootPart") then return end
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not meuHRP then return end
    
    for _, objeto in pairs(objetosSelecionados) do
        aplicarMotoresFling(objeto)
    end

    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent then return end
        local p = alvoChar.HumanoidRootPart
        for _, obj in pairs(objetosSelecionados) do
            if obj and obj.Parent then
                obj.CFrame = p.CFrame
            end
        end
    end)
end

