-- --- ATUALIZAR LISTA DE JOGADORES ---
local function atualizarListaJogadores(filtro)
    if not ui then return end

    -- Limpar lista atual (manter apenas o emptyLabel)
    local childrenToRemove = {}
    for _, child in pairs(ui.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            table.insert(childrenToRemove, child)
        end
    end
    for _, child in pairs(childrenToRemove) do
        child:Destroy()
    end

    local players = Players:GetPlayers()
    local filtroLower = filtro and string.lower(filtro) or ""
    local jogadoresEncontrados = 0

    for _, player in pairs(players) do
        if player ~= lp then
            local nome = player.Name
            if filtroLower == "" or string.find(string.lower(nome), filtroLower) then
                jogadoresEncontrados = jogadoresEncontrados + 1

                -- Criar botão do jogador
                local playerBtn = Instance.new("TextButton")
                playerBtn.Size = UDim2.new(1, -10, 0, 32)
                playerBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
                playerBtn.Text = "  " .. nome
                playerBtn.TextColor3 = Color3.fromRGB(220, 220, 255)
                playerBtn.TextXAlignment = Enum.TextXAlignment.Left
                playerBtn.Font = Enum.Font.Gotham
                playerBtn.TextSize = 14
                playerBtn.BackgroundTransparency = 0.2
                playerBtn.AutoButtonColor = false
                playerBtn.Parent = ui.PlayerList

                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 6)
                btnCorner.Parent = playerBtn

                -- Efeito de hover
                playerBtn.MouseEnter:Connect(function()
                    if jogadorSelecionado ~= player then
                        playerBtn.BackgroundTransparency = 0.05
                    end
                end)
                playerBtn.MouseLeave:Connect(function()
                    if jogadorSelecionado ~= player then
                        playerBtn.BackgroundTransparency = 0.2
                    end
                end)

                -- Selecionar jogador
                playerBtn.MouseButton1Click:Connect(function()
                    -- Resetar seleção anterior
                    for _, child in pairs(ui.PlayerList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child.BackgroundTransparency = 0.2
                            child.Size = UDim2.new(1, -10, 0, 32)
                            child.TextColor3 = Color3.fromRGB(220, 220, 255)
                        end
                    end

                    -- Selecionar novo
                    jogadorSelecionado = player
                    playerBtn.BackgroundTransparency = 0
                    playerBtn.Size = UDim2.new(1, -10, 0, 42)
                    playerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

                    -- Efeito de brilho
                    TweenService:Create(playerBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(70, 70, 120)}):Play()
                    task.wait(0.2)
                    TweenService:Create(playerBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 85)}):Play()

                    print("Jogador selecionado:", player.Name)
                    
                    -- Atualizar status
                    if ui.StatusLabel then
                        ui.StatusLabel.Text = "✅ " .. player.Name .. " selecionado!"
                        ui.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                        ui.StatusLabel.Visible = true
                        task.wait(1.5)
                        ui.StatusLabel.Visible = false
                    end
                end)
            end
        end
    end

    -- Mostrar/ocultar label de vazio
    if ui.EmptyLabel then
        ui.EmptyLabel.Visible = (jogadoresEncontrados == 0)
    end

    -- Atualizar CanvasSize
    local count = 0
    for _, child in pairs(ui.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            count = count + 1
        end
    end
    ui.PlayerList.CanvasSize = UDim2.new(0, 0, 0, math.max(count * 36 + 10, 190))
end

-- --- ENCONTRAR VEÍCULOS DO JOGADOR ---
local function encontrarMeusVeiculos()
    local meusVeiculos = {}
    local veiculosVistos = {}

    -- 1. Buscar em Workspace.Vehicles
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    if vehiclesFolder then
        for _, modelo in pairs(vehiclesFolder:GetChildren()) do
            if modelo:IsA("Model") then
                -- Verifica se é veículo do jogador (nome contém nome do jogador)
                if string.find(modelo.Name, lp.Name) or string.find(modelo.Name, "Gabrielle") then
                    -- Pega a PrimaryPart ou primeiro VehicleSeat
                    local primaryPart = modelo.PrimaryPart
                    if not primaryPart then
                        local seat = modelo:FindFirstChildOfClass("VehicleSeat")
                        if seat then
                            primaryPart = seat
                        end
                    end
                    
                    if primaryPart and not veiculosVistos[primaryPart] then
                        veiculosVistos[primaryPart] = true
                        table.insert(meusVeiculos, primaryPart)
                        
                        -- Verifica se é helicóptero e faz seat-hop
                        local nomeLower = string.lower(modelo.Name)
                        if nomeLower:find("helicopter") or nomeLower:find("chinook") or nomeLower:find("chopper") then
                            local seat = modelo:FindFirstChildOfClass("VehicleSeat") or modelo:FindFirstChild("PilotSeat", true)
                            if seat then
                                executarBypassNetworkOwnership(seat)
                            end
                        end
                    end
                end
            end
        end
    end

    -- 2. Também buscar por NetworkOwner (veículos que o jogador controla)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj:IsA("Model") == false then
            local networkOwner = obj:GetNetworkOwner()
            if networkOwner == lp then
                local modeloPai = obj:FindFirstAncestorOfClass("Model")
                if modeloPai and modeloPai:FindFirstChildOfClass("VehicleSeat") then
                    -- Evitar duplicatas
                    if not veiculosVistos[obj] then
                        veiculosVistos[obj] = true
                        table.insert(meusVeiculos, obj)
                    end
                end
            end
        end
    end

    return meusVeiculos
end

-- --- FUNÇÃO PRINCIPAL: LANÇAR MATTER ---
local function lancarMatter()
    if not jogadorSelecionado then
        if ui and ui.StatusLabel then
            ui.StatusLabel.Text = "⚠️ Selecione um jogador primeiro!"
            ui.StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            ui.StatusLabel.Visible = true
            task.wait(2)
            ui.StatusLabel.Visible = false
        end
        print("Selecione um jogador primeiro!")
        return
    end

    -- Verificar se o jogador ainda está no jogo
    if not jogadorSelecionado.Parent then
        if ui and ui.StatusLabel then
            ui.StatusLabel.Text = "⚠️ Jogador saiu do jogo!"
            ui.StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            ui.StatusLabel.Visible = true
            task.wait(2)
            ui.StatusLabel.Visible = false
        end
        jogadorSelecionado = nil
        return
    end

    -- Atualizar status
    if ui and ui.StatusLabel then
        ui.StatusLabel.Text = "🔍 Coletando veículos..."
        ui.StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
        ui.StatusLabel.Visible = true
    end

    print("Coletando veículos do jogador:", lp.Name)

    -- 1. Coletar veículos do jogador
    local veiculosColetados = encontrarMeusVeiculos()
    
    print("Veículos encontrados:", #veiculosColetados)

    if #veiculosColetados == 0 then
        if ui and ui.StatusLabel then
            ui.StatusLabel.Text = "⚠️ Nenhum veículo encontrado!"
            ui.StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            ui.StatusLabel.Visible = true
            task.wait(2)
            ui.StatusLabel.Visible = false
        end
        print("Nenhum veículo encontrado!")
        return
    end

    -- 2. Aplicar motores e lançar
    objetosSelecionados = veiculosColetados

    -- Atualizar o texto do botão da tool
    atualizarTexto()

    -- Atualizar status
    if ui and ui.StatusLabel then
        ui.StatusLabel.Text = "🚀 Lançando " .. #veiculosColetados .. " veículos em " .. jogadorSelecionado.Name .. "..."
        ui.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        ui.StatusLabel.Visible = true
    end

    -- 3. Executar o ataque
    iniciarAtaqueMassa(jogadorSelecionado)

    -- Resetar seleção visual após iniciar
    for _, child in pairs(ui.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child.BackgroundTransparency = 0.2
            child.Size = UDim2.new(1, -10, 0, 32)
            child.TextColor3 = Color3.fromRGB(220, 220, 255)
        end
    end
    jogadorSelecionado = nil

    -- Esconder status após 2 segundos
    task.wait(2)
    if ui and ui.StatusLabel then
        ui.StatusLabel.Visible = false
    end
end

