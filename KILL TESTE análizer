-- --- VERIFICAÇÃO ESPECÍFICA DE HELICÓPTEROS (CORRIGIDO) ---
local function ehHelicoptero(instancia)
    if not instancia then return false end
    
    -- Obtém o modelo real
    local model = instancia:IsA("Model") and instancia or instancia:FindFirstAncestorOfClass("Model")
    if not model then return false end
    
    -- Verifica pelo nome
    local nome = string.lower(model.Name)
    local padroesHeli = {
        "chinook", "heli", "copter", "helicopter", "chopper",
        "uh-60", "uh60", "ah-64", "ah64", "apache", "blackhawk",
        "bell", "robinson", "ec-145", "ec145", "h145", "md-500",
        "md500", "bo-105", "bo105", "enstrom", "sikorsky", "eurocopter",
        "airbus", "agusta", "westland", "mi-24", "mi24", "hind",
        "osprey", "v-22", "v22", "merlin", "lynx", "gazelle"
    }
    
    for _, padrao in pairs(padroesHeli) do
        if string.find(nome, padrao) then
            return true
        end
    end
    
    -- Verifica por partes típicas de helicóptero
    if model:FindFirstChild("Rotor") or 
       model:FindFirstChild("MainRotor") or 
       model:FindFirstChild("TailRotor") or
       model:FindFirstChild("RotorHead") or
       model:FindFirstChild("Blades") then
        return true
    end
    
    return false
end

-- --- ENCONTRAR ASSENTO NO MODELO ---
local function encontrarAssento(modelo)
    if not modelo then return nil end
    
    -- Tenta VehicleSeat
    local assento = modelo:FindFirstChildOfClass("VehicleSeat")
    if assento then return assento end
    
    -- Tenta PilotSeat
    assento = modelo:FindFirstChild("PilotSeat", true)
    if assento then return assento end
    
    -- Procura por qualquer parte com nome de assento
    for _, child in pairs(modelo:GetDescendants()) do
        if child:IsA("BasePart") then
            local nome = string.lower(child.Name)
            if string.find(nome, "seat") or 
               string.find(nome, "pilot") or 
               string.find(nome, "driver") or
               string.find(nome, "cockpit") then
                return child
            end
        end
    end
    
    return nil
end

-- --- BYPASS NETWORK OWNERSHIP CORRIGIDO (COM VERIFICAÇÃO) ---
local function executarBypassNetworkOwnership(assentoAlvo)
    if bypassEmAndamento then return false end
    if aguardandoRetorno then return false end
    
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    local meuHum = character and character:FindFirstChildOfClass("Humanoid")
    
    if not meuHRP or not meuHum or not assentoAlvo then return false end
    if not assentoAlvo:IsA("BasePart") then return false end
    
    -- Salva posição original
    posicaoOriginal = meuHRP.CFrame
    
    -- Verifica distância
    local distancia = (meuHRP.Position - assentoAlvo.Position).Magnitude
    if distancia > 150 then
        print("Assento muito distante: " .. distancia)
        return false
    end
    
    bypassEmAndamento = true
    
    local sucesso = false
    task.spawn(function()
        pcall(function()
            -- 1. Teleporta para o assento
            meuHRP.CFrame = assentoAlvo.CFrame
            task.wait(0.5) -- Tempo para o jogo registrar
            
            -- 2. Força sair do assento
            meuHum.Sit = false
            meuHum.Jump = true
            task.wait(0.2)
            
            -- 3. Pequena pausa para estabilizar
            task.wait(0.1)
            
            -- 4. Volta para posição original
            if posicaoOriginal then
                meuHRP.CFrame = posicaoOriginal
                sucesso = true
            end
        end)
        
        bypassEmAndamento = false
        aguardandoRetorno = false
        
        if sucesso then
            print("Bypass executado com sucesso!")
        else
            print("Falha no bypass, tentando recuperar posição...")
            -- Tenta recuperar posição se algo deu errado
            if posicaoOriginal and meuHRP then
                pcall(function()
                    meuHRP.CFrame = posicaoOriginal
                end)
            end
            bypassEmAndamento = false
        end
    end)
    
    return true
end

