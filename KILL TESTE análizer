local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
local playerGui = lp:WaitForChild("PlayerGui")
local character = lp.Character or lp.CharacterAdded:Wait()
local camera = Workspace.CurrentCamera

-- ============================================
-- CONFIGURAÇÕES
-- ============================================
local CONFIG = {
    BotaoPosX = 0.02,      -- Posição X do botão na tela
    BotaoPosY = 0.45,      -- Posição Y do botão na tela
    TamanhoBotao = 80,     -- Tamanho do botão em pixels
    DistanciaMaxima = 150, -- Distância máxima para bypass
    TempoEspera = 0.5,     -- Tempo de espera para teleporte
}

-- ============================================
-- VARIÁVEIS DE ESTADO
-- ============================================
local modoAtivo = false
local objetosSelecionados = {}
local conexaoAtaque = nil
local posicaoOriginal = nil
local bypassEmAndamento = false
local botaoCriado = false
local teclaAtalho = Enum.KeyCode.G -- Tecla G para ativar/desativar

-- ============================================
-- ATUALIZAR REFERÊNCIA DO CHARACTER
-- ============================================
local function atualizarCharacter(newChar)
    character = newChar
    posicaoOriginal = nil
    bypassEmAndamento = false
    -- Não resetar a seleção ao renascer
end

lp.CharacterAdded:Connect(atualizarCharacter)

-- ============================================
-- FUNÇÃO PARA CRIAR O BOTÃO
-- ============================================
local function criarBotao()
    if botaoCriado then return end
    
    -- Remove botão antigo se existir
    local oldButton = playerGui:FindFirstChild("SelectMatterV4Button")
    if oldButton then oldButton:Destroy() end
    
    local button = Instance.new("TextButton")
    button.Name = "SelectMatterV4Button"
    button.Parent = playerGui
    button.Size = UDim2.new(0, CONFIG.TamanhoBotao, 0, CONFIG.TamanhoBotao)
    button.Position = UDim2.new(CONFIG.BotaoPosX, 0, CONFIG.BotaoPosY, -(CONFIG.TamanhoBotao/2))
    button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    button.BackgroundTransparency = 0
    button.BorderSizePixel = 0
    button.Text = "SELECT\nMATTER"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextTransparency = 0
    button.Font = Enum.Font.Arcade
    button.TextScaled = true
    button.TextWrapped = true
    button.ZIndex = 10
    button.Visible = true
    button.Active = true
    button.Selectable = true
    button.MouseButton1Click:Connect(function()
        toggleModo()
    end)
    
    -- Estilo do botão
    local uiStroke = Instance.new("UIStroke", button)
    uiStroke.Color = Color3.fromRGB(255, 255, 255)
    uiStroke.Thickness = 3
    uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    
    local uiCorner = Instance.new("UICorner", button)
    uiCorner.CornerRadius = UDim.new(0, 2)
    
    botaoCriado = true
    atualizarTexto()
    return button
end

-- ============================================
-- ATUALIZAR TEXTO DO BOTÃO
-- ============================================
local function atualizarTexto()
    local button = playerGui:FindFirstChild("SelectMatterV4Button")
    if not button then return end
    
    if #objetosSelecionados > 0 then
        button.Text = "DESTROY\n(" .. #objetosSelecionados .. ")"
    else
        button.Text = "SELECT\nMATTER"
    end
end

-- ============================================
-- ALTERNAR MODO
-- ============================================
function toggleModo()
    if modoAtivo then
        resetarEstado()
    else
        modoAtivo = true
        local button = playerGui:FindFirstChild("SelectMatterV4Button")
        if button then
            button.BackgroundTransparency = 0.45
            button.TextTransparency = 0.2
        end
        print("[SELECT MATTER] Modo ATIVADO - Clique em objetos para selecionar")
    end
end

-- ============================================
-- RESETAR ESTADO
-- ============================================
local function resetarEstado()
    if conexaoAtaque then
        conexaoAtaque:Disconnect()
        conexaoAtaque = nil
    end
    objetosSelecionados = {}
    modoAtivo = false
    posicaoOriginal = nil
    bypassEmAndamento = false
    
    local button = playerGui:FindFirstChild("SelectMatterV4Button")
    if button then
        button.BackgroundTransparency = 0
        button.TextTransparency = 0
    end
    atualizarTexto()
    print("[SELECT MATTER] Modo DESATIVADO")
end

-- ============================================
-- VERIFICAR SE É HELICÓPTERO
-- ============================================
local function ehHelicoptero(instancia)
    if not instancia then return false end
    
    local model = instancia:IsA("Model") and instancia or instancia:FindFirstAncestorOfClass("Model")
    if not model then return false end
    
    local nome = string.lower(model.Name)
    local padroesHeli = {
        "chinook", "heli", "copter", "helicopter", "chopper",
        "uh-60", "uh60", "ah-64", "ah64", "apache", "blackhawk",
        "bell", "robinson", "ec-145", "ec145", "h145", "md-500",
        "md500", "bo-105", "bo105", "enstrom", "sikorsky", "eurocopter",
        "airbus", "agusta", "westland", "mi-24", "mi24", "hind",
        "osprey", "v-22", "v22", "merlin", "lynx", "gazelle"
    }
    
    for _, padrao in pairs(padroesHeli) do
        if string.find(nome, padrao) then
            return true
        end
    end
    
    if model:FindFirstChild("Rotor") or 
       model:FindFirstChild("MainRotor") or 
       model:FindFirstChild("TailRotor") then
        return true
    end
    
    return false
end

-- ============================================
-- ENCONTRAR ASSENTO
-- ============================================
local function encontrarAssento(modelo)
    if not modelo then return nil end
    
    local assento = modelo:FindFirstChildOfClass("VehicleSeat")
    if assento then return assento end
    
    assento = modelo:FindFirstChild("PilotSeat", true)
    if assento then return assento end
    
    for _, child in pairs(modelo:GetDescendants()) do
        if child:IsA("BasePart") then
            local nome = string.lower(child.Name)
            if string.find(nome, "seat") or 
               string.find(nome, "pilot") or 
               string.find(nome, "driver") or
               string.find(nome, "cockpit") then
                return child
            end
        end
    end
    
    return nil
end

-- ============================================
-- BYPASS NETWORK OWNERSHIP (SEAT-HOP)
-- ============================================
local function executarBypassNetworkOwnership(assentoAlvo)
    if bypassEmAndamento then return false end
    
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    local meuHum = character and character:FindFirstChildOfClass("Humanoid")
    
    if not meuHRP or not meuHum or not assentoAlvo then return false end
    if not assentoAlvo:IsA("BasePart") then return false end
    
    local distancia = (meuHRP.Position - assentoAlvo.Position).Magnitude
    if distancia > CONFIG.DistanciaMaxima then
        print("[BYPASS] Assento muito distante: " .. distancia)
        return false
    end
    
    posicaoOriginal = meuHRP.CFrame
    bypassEmAndamento = true
    
    task.spawn(function()
        local sucesso = false
        pcall(function()
            print("[BYPASS] Teleportando para o assento...")
            meuHRP.CFrame = assentoAlvo.CFrame
            task.wait(CONFIG.TempoEspera)
            
            print("[BYPASS] Saindo do assento...")
            meuHum.Sit = false
            meuHum.Jump = true
            task.wait(0.3)
            
            print("[BYPASS] Voltando para posição original...")
            if posicaoOriginal then
                meuHRP.CFrame = posicaoOriginal
                sucesso = true
            end
        end)
        
        bypassEmAndamento = false
        
        if sucesso then
            print("[BYPASS] ✅ Bypass executado com sucesso!")
        else
            print("[BYPASS] ❌ Falha no bypass, tentando recuperar posição...")
            if posicaoOriginal and meuHRP then
                pcall(function()
                    meuHRP.CFrame = posicaoOriginal
                end)
            end
        end
    end)
    
    return true
end

-- ============================================
-- APLICAR MOTORES DE FLING
-- ============================================
local function aplicarMotoresFling(corpo)
    -- Remove motores antigos
    for _, child in pairs(corpo:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then
            child:Destroy()
        end
    end

    corpo.CanCollide = true
    corpo.Massless = false
    
    pcall(function()
        corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)
    end)
    
    local forcaMassiva = Vector3.new(9e9, 9e9, 9e9)

    -- BodyVelocity para movimento linear
    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "FlingPowerLinear"
    velocity.Velocity = Vector3.new(999999, 999999, 999999)
    velocity.MaxForce = forcaMassiva
    velocity.P = 10000
    velocity.Parent = corpo  

    -- BodyAngularVelocity para rotação
    local angularVelocity = Instance.new("BodyAngularVelocity")
    angularVelocity.Name = "FlingPowerAngular"
    angularVelocity.AngularVelocity = Vector3.new(999999, 999999, 999999)
    angularVelocity.MaxTorque = forcaMassiva
    angularVelocity.P = 10000
    angularVelocity.Parent = corpo
end

-- ============================================
-- INICIAR ATAQUE EM MASSA
-- ============================================
local function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or not alvoChar:FindFirstChild("HumanoidRootPart") then 
        print("[ATAQUE] Alvo inválido!")
        return 
    end

    local alvoHum = alvoChar:FindFirstChildOfClass("Humanoid")
    if not alvoHum or alvoHum.Health <= 0 then
        print("[ATAQUE] Alvo já está morto!")
        return
    end

    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not meuHRP or #objetosSelecionados == 0 then 
        print("[ATAQUE] Sem objetos selecionados!")
        return 
    end

    print("[ATAQUE] Iniciando ataque em " .. alvoPlayer.Name .. " com " .. #objetosSelecionados .. " objetos!")

    -- Aplica motores de fling em todos os objetos
    for _, objeto in pairs(objetosSelecionados) do
        if objeto and objeto.Parent then
            aplicarMotoresFling(objeto)
            
            -- Tenta transferir network ownership
            if objeto.SetNetworkOwner then
                pcall(function() objeto:SetNetworkOwner(lp) end)
            end
        end
    end

    local partesAlvo = {"HumanoidRootPart", "Head", "LowerTorso", "UpperTorso"}
    local indexParte = 1
    local tempoBase = tick()

    if conexaoAtaque then
        conexaoAtaque:Disconnect()
        conexaoAtaque = nil
    end

    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent or not alvoHum or alvoHum.Health <= 0 or #objetosSelecionados == 0 then
            print("[ATAQUE] Alvo morreu ou sem objetos, finalizando...")
            resetarEstado()
            return
        end

        local nomeParte = partesAlvo[indexParte]
        local p = alvoChar:FindFirstChild(nomeParte)

        if p then
            local tempo = tick() * 30
            local offsetCurto = Vector3.new(0, 0, 0)
            
            if p.AssemblyLinearVelocity and p.AssemblyLinearVelocity.Magnitude > 0.1 then
                offsetCurto = p.AssemblyLinearVelocity.Unit * 0.5
            end

            for i = #objetosSelecionados, 1, -1 do
                local objeto = objetosSelecionados[i]

                if objeto and objeto.Parent then
                    -- Calcula posição orbital
                    local angulo = tempo + (i * (math.pi * 2 / #objetosSelecionados))
                    local raio = 1.5 + (math.sin(tempo * 0.5 + i) * 0.5)
                    
                    local offsetOrbital = Vector3.new(
                        math.cos(angulo) * raio,
                        math.sin(angulo * 1.3) * raio * 0.8,
                        math.sin(angulo) * raio
                    )

                    local posicaoFinal = p.Position + offsetCurto + offsetOrbital
                    local direcaoGiro = CFrame.Angles(
                        math.sin(tempo + i) * 2,
                        math.cos(tempo + i) * 2,
                        math.sin(tempo * 0.5 + i) * 2
                    )

                    -- Move o objeto
                    objeto.CFrame = CFrame.new(posicaoFinal) * direcaoGiro
                    
                    -- Aplica velocidade
                    if objeto:IsA("BasePart") then
                        objeto.Velocity = Vector3.new(99999, 99999, 99999)
                        objeto.RotVelocity = Vector3.new(99999, 99999, 99999)
                    end
                else
                    table.remove(objetosSelecionados, i)
                    atualizarTexto()
                end
            end
        end

        indexParte = indexParte + 1
        if indexParte > #partesAlvo then indexParte = 1 end
    end)
end

-- ============================================
-- CAPTURA DE CLIQUES NO MUNDO
-- ============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not modoAtivo then return end
    if bypassEmAndamento then return end
    if not botaoCriado then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local pos = input.Position
        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)

        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {character}

        local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 50000, raycastParams)

        if raycastResult and raycastResult.Instance then
            local hitPart = raycastResult.Instance
            local model = hitPart:FindFirstAncestorOfClass("Model")

            -- CASO 1: Clicou em um jogador
            if model and model:FindFirstChildOfClass("Humanoid") then
                local tPlayer = Players:GetPlayerFromCharacter(model)
                if tPlayer and tPlayer ~= lp and #objetosSelecionados > 0 then
                    print("[SELECAO] Atacando " .. tPlayer.Name)
                    iniciarAtaqueMassa(tPlayer)
                end

            -- CASO 2: Clicou em um objeto
            else
                local alvoFisico = nil
                local modeloVeiculo = hitPart:FindFirstAncestorOfClass("Model") or hitPart

                if hitPart.Anchored == false and hitPart:IsA("BasePart") then
                    alvoFisico = hitPart
                end

                if alvoFisico and not table.find(objetosSelecionados, alvoFisico) then
                    table.insert(objetosSelecionados, alvoFisico)
                    atualizarTexto()
                    print("[SELECAO] Objeto selecionado: " .. (alvoFisico.Name or "Part"))

                    -- Verifica se é helicóptero e faz bypass
                    local modeloReal = alvoFisico:FindFirstAncestorOfClass("Model") or alvoFisico
                    if ehHelicoptero(modeloReal) then
                        print("[HELI] Helicóptero detectado!")
                        local assento = encontrarAssento(modeloReal)
                        if assento then
                            print("[HELI] Assento encontrado: " .. assento.Name)
                            executarBypassNetworkOwnership(assento)
                        end
                    end
                end
            end
        end
    end
end)

