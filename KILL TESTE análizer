-- ============================================
-- HOOK PARA EQUIPAR/DESEQUIPAR A TOOL
-- ============================================
-- O script base já chama OnEquip/OnUnequip
-- Vamos modificar o toolData existente via _G

local function mostrarInterface()
    if ui and ui.ScreenGui then
        ui.ScreenGui.Enabled = true
        interfaceVisivel = true
        atualizarListaJogadores(ui.SearchBox.Text or "")
    end
end

local function esconderInterface()
    if ui and ui.ScreenGui then
        ui.ScreenGui.Enabled = false
        interfaceVisivel = false
    end
    jogadorSelecionado = nil
end

-- Registrar hooks para o script base usar
_G.SelectMatterHooks = {
    OnEquip = mostrarInterface,
    OnUnequip = esconderInterface
}

-- Verificar se o script base já carregou e aplicar hooks
if _G.ScriptAdapter and _G.ScriptAdapter.RegisterTool then
    -- O script base já registrou a tool
    -- Vamos sobrescrever os hooks
    for _, tool in pairs(_G.ScriptAdapter.Queue or {}) do
        if tool.Id == "SelectMatterV4_Tool" then
            tool.OnEquip = function()
                mostrarInterface()
                -- Manter comportamento original
                if _G._toolOnEquip then _G._toolOnEquip() end
            end
            tool.OnUnequip = function()
                esconderInterface()
                if _G._toolOnUnequip then _G._toolOnUnequip() end
            end
        end
    end
end

