local function aplicarMotoresFling(corpo)
    for _, c in pairs(corpo:GetChildren()) do if c:IsA("BodyVelocity") or c:IsA("BodyAngularVelocity") then c:Destroy() end end
    local bv = Instance.new("BodyVelocity", corpo); bv.Velocity = Vector3.new(999999, 999999, 999999); bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
    local ba = Instance.new("BodyAngularVelocity", corpo); ba.AngularVelocity = Vector3.new(999999, 999999, 999999); ba.MaxTorque = Vector3.new(1/0, 1/0, 1/0)
end

local function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or #objetosSelecionados == 0 then return end
    
    if conexaoAtaque then conexaoAtaque:Disconnect() end
    
    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent then return end
        local p = alvoChar:FindFirstChild("HumanoidRootPart")
        if p then
            for _, obj in pairs(objetosSelecionados) do
                if obj and obj.Parent then
                    obj.CFrame = p.CFrame
                    obj.Velocity = Vector3.new(999999, 999999, 999999)
                end
            end
        end
    end)
end

local function executarLancamento()
    if not jogadorAlvoSelecionado then return end
    
    -- 1. Invocar
    pcall(function() ReplicatedStorage.RE["1Ca1r"]:FireServer("PickingCar", "Bobsled", "Event") end)
    task.wait(1.5)
    
    -- 2. Encontrar e Capturar
    local veiculo = nil
    for _, v in pairs(Workspace.Vehicles:GetChildren()) do
        if v.Name:find("Bobsled") then veiculo = v break end
    end
    
    if veiculo then
        objetosSelecionados = {}
        for _, d in pairs(veiculo:GetDescendants()) do
            if d:IsA("BasePart") and not d.Anchored then table.insert(objetosSelecionados, d) end
        end
        -- Bypass
        local seat = veiculo:FindFirstChildOfClass("VehicleSeat", true)
        if seat then
            local p = lp.Character.HumanoidRootPart
            local pos = p.CFrame
            p.CFrame = seat.CFrame
            task.wait(0.2)
            lp.Character.Humanoid.Sit = false
            p.CFrame = pos
        end
        iniciarAtaqueMassa(jogadorAlvoSelecionado)
    end
end

