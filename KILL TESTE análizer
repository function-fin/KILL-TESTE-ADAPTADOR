local function atualizarListaJogadores()
    for _, child in pairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local filtro = searchBox.Text:lower()
    local alturaTotal = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp then
            local nome = plr.Name
            local displayName = plr.DisplayName

            if filtro == "" or nome:lower():find(filtro) or displayName:lower():find(filtro) then
                local pBtn = Instance.new("TextButton")
                pBtn.Name = nome
                pBtn.Size = UDim2.new(1, 0, 0, 20)
                pBtn.BackgroundTransparency = 1
                pBtn.BorderSizePixel = 0
                pBtn.Text = displayName
                pBtn.TextColor3 = (jogadorAlvoSelecionado == plr) and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(255, 255, 255)
                pBtn.Font = Enum.Font.SourceSansBold
                pBtn.TextSize = 14
                pBtn.TextXAlignment = Enum.TextXAlignment.Left
                pBtn.Parent = playerScroll

                pBtn.MouseButton1Click:Connect(function()
                    jogadorAlvoSelecionado = plr
                    atualizarListaJogadores()

                    if #objetosSelecionados > 0 then
                        iniciarAtaqueMassa(plr)
                    end
                end)

                alturaTotal = alturaTotal + 22
            end
        end
    end

    playerScroll.CanvasSize = UDim2.new(0, 0, 0, alturaTotal)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(atualizarListaJogadores)
Players.PlayerAdded:Connect(atualizarListaJogadores)
