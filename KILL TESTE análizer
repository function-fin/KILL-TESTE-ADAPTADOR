-- --- CAPTURA DE CLIQUES NO MUNDO (CORRIGIDO) ---
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Ignora se o jogo processou ou se o modo não está ativo
    if gameProcessed or not modoAtivo then return end
    if bypassEmAndamento or aguardandoRetorno then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)

        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {character}

        local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 50000, raycastParams)

        if raycastResult and raycastResult.Instance then
            local hitPart = raycastResult.Instance
            local model = hitPart:FindFirstAncestorOfClass("Model")

            -- CASO 1: Clicar em um jogador inimigo (Executar Ataque)
            if model and model:FindFirstChild("Humanoid") then
                local tPlayer = Players:GetPlayerFromCharacter(model)

                if tPlayer and tPlayer ~= lp then
                    if #objetosSelecionados > 0 then
                        if conexaoAtaque then conexaoAtaque:Disconnect() end
                        iniciarAtaqueMassa(tPlayer)
                    end
                end

            -- CASO 2: Clicar em objetos/veículos físicos (Adicionar à lista)
            else
                local alvoFisico = nil
                local modeloVeiculo = hitPart:FindFirstAncestorOfClass("Model") or hitPart

                -- Determina o alvo físico
                if hitPart.Anchored == false then
                    if hitPart:IsA("BasePart") then
                        alvoFisico = hitPart
                    elseif modeloVeiculo:IsA("Model") and modeloVeiculo.PrimaryPart then
                        alvoFisico = modeloVeiculo.PrimaryPart
                    else
                        alvoFisico = hitPart
                    end
                end

                -- PRIMEIRO: Adiciona o objeto à seleção
                if alvoFisico and not table.find(objetosSelecionados, alvoFisico) then
                    table.insert(objetosSelecionados, alvoFisico)
                    atualizarTexto()
                    print("Objeto selecionado: " .. (alvoFisico.Name or "sem nome"))

                    -- SEGUNDO: Verifica se é helicóptero e faz o bypass
                    -- Obtém o modelo real para verificação
                    local modeloReal = alvoFisico:FindFirstAncestorOfClass("Model") or alvoFisico
                    
                    if ehHelicoptero(modeloReal) then
                        print("Helicóptero detectado! Buscando assento...")
                        
                        -- Encontra o assento
                        local assentoEncontrado = encontrarAssento(modeloReal)
                        
                        if assentoEncontrado then
                            print("Assento encontrado: " .. assentoEncontrado.Name)
                            -- Executa o bypass (agora que o objeto já está selecionado)
                            aguardandoRetorno = true
                            local bypassExecutado = executarBypassNetworkOwnership(assentoEncontrado)
                            
                            if not bypassExecutado then
                                aguardandoRetorno = false
                                print("Falha ao executar bypass no assento")
                            else
                                print("Bypass em andamento para o helicóptero")
                            end
                        else
                            print("Nenhum assento encontrado no helicóptero")
                        end
                    end
                end
            end
        end
    end
end)

