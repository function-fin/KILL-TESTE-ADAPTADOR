-- --- MOTORES DE FLING ---
local function aplicarMotoresFling(corpo)
    for _, child in pairs(corpo:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") or child.Name == "BobsledSpinMotor" then
            child:Destroy()
        end
    end

    corpo.CanCollide = true
    corpo.Massless = false
    corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)

    local forcaMassiva = Vector3.new(math.huge * math.huge, math.huge * math.huge, math.huge * math.huge)

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "FlingPowerLinear"
    velocity.Velocity = Vector3.new(999999, 999999, 999999)
    velocity.MaxForce = forcaMassiva
    velocity.P = math.huge
    velocity.Parent = corpo  

    local angularVelocity = Instance.new("BodyAngularVelocity")
    angularVelocity.Name = "FlingPowerAngular"
    angularVelocity.AngularVelocity = Vector3.new(999999, 999999, 999999)
    angularVelocity.MaxTorque = forcaMassiva
    angularVelocity.P = math.huge
    angularVelocity.Parent = corpo
end

-- --- BYPASS NETWORK OWNERSHIP (SEAT-HOPPING) ---
local function executarBypassNetworkOwnership(assentoAlvo)
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    local meuHum = character and character:FindFirstChildOfClass("Humanoid")
    if not meuHRP or not meuHum or not assentoAlvo then return false end
    
    -- Salvar posição original
    posicaoOriginal = meuHRP.CFrame
    
    -- Verificar se o assento é válido
    if not assentoAlvo:IsA("BasePart") then return false end
    
    -- Verificar distância para evitar teleportes muito longos
    local distancia = (meuHRP.Position - assentoAlvo.Position).Magnitude
    if distancia > 150 then 
        return false 
    end
    
    -- Executar seat-hop com tempos do script base
    local sucesso = false
    pcall(function()
        -- Teleportar para o assento
        meuHRP.CFrame = assentoAlvo.CFrame
        task.wait(0.5)
        
        -- Sair do assento
        meuHum.Sit = false
        meuHum.Jump = true
        meuHRP.CFrame = assentoAlvo.CFrame + Vector3.new(0, 8, 0)
        task.wait(0.3)
        
        -- Voltar para posição original
        if posicaoOriginal then
            meuHRP.CFrame = posicaoOriginal
        end
        sucesso = true
    end)
    
    return sucesso
end

-- --- VARREDURA E COLETA AUTOMÁTICA DE VEÍCULOS ---
local function escanearEColetar()
    objetosSelecionados = {}
    local meuNick = lp.Name

    -- Buscar veículos que o jogador possui
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            -- Verificar se o veículo pertence ao jogador
            local isOwner = false
            if obj:FindFirstChild("Owner") and obj.Owner:IsA("StringValue") then
                if obj.Owner.Value == meuNick then
                    isOwner = true
                end
            end
            
            -- Verificar se o nome do modelo contém o nome do jogador
            if not isOwner and string.find(obj.Name, meuNick) then
                isOwner = true
            end
            
            if isOwner then
                local alvoFisico = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if alvoFisico and alvoFisico.Anchored == false then
                    if not table.find(objetosSelecionados, alvoFisico) then
                        table.insert(objetosSelecionados, alvoFisico)
                    end
                    
                    -- Só executa bypass se for helicóptero E tiver assento
                    if ehHelicoptero(obj) then
                        local assentoEncontrado = nil
                        
                        -- Primeiro tenta VehicleSeat
                        assentoEncontrado = obj:FindFirstChildOfClass("VehicleSeat")
                        
                        -- Depois tenta PilotSeat
                        if not assentoEncontrado then
                            assentoEncontrado = obj:FindFirstChild("PilotSeat", true)
                        end
                        
                        -- Se encontrou assento, executa bypass
                        if assentoEncontrado and assentoEncontrado:IsA("BasePart") then
                            executarBypassNetworkOwnership(assentoEncontrado)
                        end
                    end
                end
            end
        end
    end
    atualizarTexto()
end

-- --- EXECUÇÃO DO ATAQUE EM MASSA ---
local function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or not alvoChar:FindFirstChild("HumanoidRootPart") then return end

    local alvoHum = alvoChar.Humanoid
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")

    if not meuHRP or #objetosSelecionados == 0 then return end

    -- Aplicar motores de fling e constraints
    for _, objeto in pairs(objetosSelecionados) do
        if objeto and objeto.Parent then
            aplicarMotoresFling(objeto)

            local nc = Instance.new("NoCollisionConstraint", objeto)
            nc.Part0 = objeto
            nc.Part1 = meuHRP

            if sethp then
                pcall(function() sethp(objeto, "NetworkOwner", lp) end)
            elseif objeto.SetNetworkOwner then
                pcall(function() objeto:SetNetworkOwner(lp) end)
            end
        end
    end

    local partesAlvo = {"HumanoidRootPart", "Head", "LowerTorso"}
    local indexParte = 1

    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent or alvoHum.Health <= 0 or #objetosSelecionados == 0 then
            resetarEstado()
            return
        end

        local nomeParte = partesAlvo[indexParte]
        local p = alvoChar:FindFirstChild(nomeParte)

        if p then
            local offsetCurto = Vector3.new(0, 0, 0)
            if p.AssemblyLinearVelocity.Magnitude > 0.1 then
                offsetCurto = p.AssemblyLinearVelocity.Unit * 0.8
            end

            local tempo = tick() * 45 

            for i = #objetosSelecionados, 1, -1 do
                local objeto = objetosSelecionados[i]

                if objeto and objeto.Parent then
                    local angulo = tempo + (i * (math.pi / #objetosSelecionados))
                    local raio = 1 + (math.sin(tempo + i) * 0.5 + 0.5) 

                    local offsetOrbital = Vector3.new(
                        math.cos(angulo) * raio,
                        math.sin(angulo * 1.5) * raio, 
                        math.sin(angulo) * raio
                    )

                    local posicaoFinal = p.Position + offsetCurto + offsetOrbital
                    local direcaoGiro = CFrame.Angles(math.sin(tempo) * 3, math.cos(tempo) * 3, math.sin(tempo * 2) * 3)

                    objeto.CFrame = CFrame.new(posicaoFinal) * direcaoGiro
                    objeto.Velocity = Vector3.new(999999, 999999, 999999)
                    objeto.RotVelocity = Vector3.new(999999, 999999, 999999)
                else
                    table.remove(objetosSelecionados, i)
                    atualizarTexto()
                end
            end
        end

        indexParte = indexParte + 1
        if indexParte > #partesAlvo then indexParte = 1 end
    end)
end

-- --- ATUALIZAÇÃO E FILTRO DA LISTA DE JOGADORES (CORRIGIDO) ---
local function atualizarLista()
    if not _G.AuraGUI or not _G.AuraGUI.PlayerList then 
        print("Ainda não há GUI disponível")
        return 
    end
    
    local scrollList = _G.AuraGUI.PlayerList
    local listLayout = _G.AuraGUI.ListLayout
    
    -- Limpar lista existente
    for _, item in pairs(scrollList:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    -- Obter e ordenar jogadores
    local players = Players:GetPlayers()
    table.sort(players, function(a, b) return a.Name < b.Name end)
    
    -- Criar botões para cada jogador
    for _, p in pairs(players) do
        if p ~= lp then
            local btn = Instance.new("TextButton", scrollList)
            btn.Size = UDim2.new(1, -6, 0, 26)
            btn.Text = p.Name
            btn.Font = Enum.Font.Arcade
            btn.TextSize = 14
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.BorderSizePixel = 0
            btn.BackgroundTransparency = 0

            -- Destacar se for o alvo selecionado
            if alvoSelecionado and alvoSelecionado.Name == p.Name then
                btn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
            end

            btn.MouseButton1Click:Connect(function()
                alvoSelecionado = p
                -- Resetar todos os botões
                for _, child in pairs(scrollList:GetChildren()) do
                    if child:IsA("TextButton") then
                        child.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                    end
                end
                -- Destacar o selecionado
                btn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
                print("Alvo selecionado: " .. p.Name)
            end)
        end
    end
    
    -- Atualizar tamanho do canvas
    task.wait()
    scrollList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
    
    print("Lista atualizada com " .. #players - 1 .. " jogadores")
end

