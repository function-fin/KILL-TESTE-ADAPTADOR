-- ============================================
-- PROJETO KILL V4 - SISTEMA DE CAPTURA DINÂMICA
-- ============================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- --- VARIÁVEIS DE ESTADO ---
local modoAtivo = false
local objetosSelecionados = {}
local conexaoAtaque = nil

-- --- TRANCAR AUTORIDADE DE REDE ---
local sethp = sethiddenproperty or set_hidden_property
task.spawn(function()
    RunService.RenderStepped:Connect(function()
        if sethp then pcall(function() sethp(lp, "SimulationRadius", 1e30) sethp(lp, "MaxSimulationRadius", 1e30) end) end
    end)
end)

-- --- UI: BOTÃO FLUTUANTE ---
local screenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local actionButton = Instance.new("TextButton", screenGui)
actionButton.Size = UDim2.new(0, 100, 0, 50)
actionButton.Position = UDim2.new(0.5, -50, 0.9, 0)
actionButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
actionButton.BorderSizePixel = 2
actionButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
actionButton.Text = "SELECT MODE\nOFF"
actionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
actionButton.Font = Enum.Font.Arcade

-- --- FUNÇÕES DE LÓGICA ---
local function resetarEstado()
    if conexaoAtaque then conexaoAtaque:Disconnect() end
    objetosSelecionados = {}
    actionButton.Text = "SELECT MODE\nOFF"
    actionButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
end

local function aplicarFling(corpo)
    corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)
    local bv = Instance.new("BodyVelocity", corpo)
    bv.Velocity = Vector3.new(999999, 999999, 999999)
    bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
    local ba = Instance.new("BodyAngularVelocity", corpo)
    ba.AngularVelocity = Vector3.new(999999, 999999, 999999)
    ba.MaxTorque = Vector3.new(1/0, 1/0, 1/0)
end

local function atacarAlvo(alvoPlayer)
    local char = alvoPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    if conexaoAtaque then conexaoAtaque:Disconnect() end
    
    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if #objetosSelecionados == 0 or not char.Parent then resetarEstado() return end
        for _, obj in pairs(objetosSelecionados) do
            if obj and obj.Parent then
                obj.CFrame = root.CFrame
                obj.Velocity = Vector3.new(999999, 999999, 999999)
            end
        end
    end)
end

-- --- INTERAÇÃO (CLIQUES) ---
actionButton.MouseButton1Click:Connect(function()
    modoAtivo = not modoAtivo
    actionButton.Text = modoAtivo and "MODE ON\nCAPTURING" or "SELECT MODE\nOFF"
    actionButton.BackgroundColor3 = modoAtivo and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(0, 0, 0)
    if not modoAtivo then resetarEstado() end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not modoAtivo or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    
    local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
    local hit, pos = Workspace:Raycast(ray.Origin, ray.Direction * 1000)
    
    if hit then
        local model = hit.Instance:FindFirstAncestorOfClass("Model")
        
        -- AÇÃO: CLICAR EM VEÍCULO (CAPTURA/SALVAMENTO)
        if model and model:FindFirstChild("VehicleSeat") or model and model.Name:find("Car") or model.Name:find("Bobsled") then
            objetosSelecionados = {} -- Limpa captura anterior
            for _, d in pairs(model:GetDescendants()) do
                if d:IsA("BasePart") and not d.Anchored then
                    table.insert(objetosSelecionados, d)
                    aplicarFling(d)
                end
            end
            actionButton.Text = "CAPTURED\n(" .. #objetosSelecionados .. " pts)"
            
            -- Bypass de rede (Seat-hopping)
            local seat = model:FindFirstChild("VehicleSeat", true)
            if seat then
                local p = lp.Character.HumanoidRootPart
                local oldCFrame = p.CFrame
                p.CFrame = seat.CFrame
                task.wait(0.2)
                lp.Character.Humanoid.Sit = false
                p.CFrame = oldCFrame
            end
            
        -- AÇÃO: CLICAR EM JOGADOR (ATAQUE)
        elseif model and model:FindFirstChild("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(model)
            if plr and plr ~= lp then
                atacarAlvo(plr)
                actionButton.Text = "ATTACKING\n" .. plr.Name
            end
        end
    end
end)
