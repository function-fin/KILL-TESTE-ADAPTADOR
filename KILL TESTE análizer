local function aplicarMotoresFling(corpo)
    for _, child in pairs(corpo:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") or child.Name == "BobsledSpinMotor" then
            child:Destroy()
        end
    end
    corpo.CanCollide = true
    corpo.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100)
    local forcaMassiva = Vector3.new(math.huge, math.huge, math.huge)
    local velocity = Instance.new("BodyVelocity", corpo); velocity.Name = "FlingPowerLinear"; velocity.Velocity = Vector3.new(999999, 999999, 999999); velocity.MaxForce = forcaMassiva
    local angularVelocity = Instance.new("BodyAngularVelocity", corpo); angularVelocity.Name = "FlingPowerAngular"; angularVelocity.AngularVelocity = Vector3.new(999999, 999999, 999999); angularVelocity.MaxTorque = forcaMassiva
end

local function executarBypassNetworkOwnership(assentoAlvo)
    local meuHRP = character and character:FindFirstChild("HumanoidRootPart")
    local meuHum = character and character:FindFirstChildOfClass("Humanoid")
    if not meuHRP or not meuHum or not assentoAlvo then return end
    local posOrig = meuHRP.CFrame
    meuHRP.CFrame = assentoAlvo.CFrame
    task.wait(0.4)
    meuHum.Sit = false; meuHum.Jump = true
    meuHRP.CFrame = assentoAlvo.CFrame + Vector3.new(0, 5, 0)
    task.wait(0.2)
    meuHRP.CFrame = posOrig
end

-- --- LÓGICA DE SCANNER (COLETA DE VEÍCULOS) ---
local function escanearVeiculos()
    objetosSelecionados = {}
    local meuNick = lp.Name
    
    -- Varre o workspace procurando modelos com seu nome
    for _, model in pairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and string.find(model.Name, meuNick) then
            local p = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if p then
                table.insert(objetosSelecionados, p)
                
                -- Detectar Assento e realizar Bypass
                local assento = model:FindFirstChild("PilotSeat", true) or model:FindFirstChildOfClass("VehicleSeat") or model:FindFirstChild("Seats", true):FindFirstChildOfClass("VehicleSeat")
                if assento then
                    executarBypassNetworkOwnership(assento)
                end
            end
        end
    end
end

-- --- EXECUÇÃO DO ATAQUE ---
local function iniciarAtaqueMassa(alvoPlayer)
    local alvoChar = alvoPlayer.Character
    if not alvoChar or not alvoChar:FindFirstChild("HumanoidRootPart") or #objetosSelecionados == 0 then return end
    
    for _, objeto in pairs(objetosSelecionados) do
        if objeto and objeto.Parent then
            aplicarMotoresFling(objeto)
            if sethp then pcall(function() sethp(objeto, "NetworkOwner", lp) end) end
        end
    end

    conexaoAtaque = RunService.Heartbeat:Connect(function()
        if not alvoChar.Parent or not alvoChar:FindFirstChild("HumanoidRootPart") then
            if conexaoAtaque then conexaoAtaque:Disconnect() end
            return
        end
        local p = alvoChar.HumanoidRootPart
        local tempo = tick() * 45
        for i, objeto in pairs(objetosSelecionados) do
            local angulo = tempo + (i * (math.pi / #objetosSelecionados))
            local raio = 3
            local pos = p.Position + Vector3.new(math.cos(angulo)*raio, math.sin(tempo)*2, math.sin(angulo)*raio)
            objeto.CFrame = CFrame.new(pos)
        end
    end)
end

